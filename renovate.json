{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "helmChartYamlAppVersions": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "archived/**"
  ],
  "packageRules": [
    {
      "matchFileNames": ["charts/**"],
      "commitMessageTopic": "{{parentDir}} - {{depName}}",
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.{yaml,yml}"],
          "matchStrings": ["version:\\s(?<version>[^\\s]+)"],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchPackageNames": ["nginx"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
